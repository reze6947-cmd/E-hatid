rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helper functions
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isAdmin() {
      return isAuthenticated()
        && getUserData(request.auth.uid).roles.hasAny(['admin']);
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData(request.auth.uid).roles.hasAny([role]);
    }

    function roleStatusIs(role, status) {
      return isAuthenticated()
        && getUserData(request.auth.uid).roleStatus[role] == status;
    }

    function isRole(role) {
      return hasRole(role) || roleStatusIs(role, 'approved');
    }

    // ============================================================
    // Master admin bootstrap
    // The user whose SERVER-VERIFIED Firebase Auth email matches the
    // address below may promote only their OWN account to admin.
    // Keep this in sync with VITE_ADMIN_EMAIL in .env.
    // ============================================================
    function isMasterAdmin() {
      return isAuthenticated()
        && request.auth.token.email == 'admin@ehatid.com';
    }

    // ============================================================
    // Allowed write fields for users updating their own profile
    // ============================================================
    function allowedUserFields() {
      return ['name', 'phone', 'age', 'avatar', 'address', 'password',
              'latitude', 'longitude',
              'vehicle', 'licensePlate', 'licenseNumber',
              'bankAccount', 'bankName', 'riderAvailable',
              'firstName', 'middleName', 'lastName', 'suffix',
              'addressStreet', 'addressBarangay', 'addressCity',
              'addressProvince', 'addressRegion', 'addressZip',
              'activeRole'];
    }

    function isAllowedUserWrite() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(allowedUserFields());
    }

    // ============================================================
    // users/{uid}
    // - User can read their own document
    // - User can update only allowed profile fields + OTP verification
    // - Admin can read/write any user document
    // - Cloud Function (Admin SDK) handles role/roles/roleStatus changes
    // ============================================================
    match /users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      // A user may create their own account document, but only as a customer.
      // Role promotions (rider/vendor/admin) must be granted by an admin / Cloud Function.
      // The master admin may instead bootstrap their own document directly as an admin.
      allow create: if isAuthenticated()
                  && request.auth.uid == uid
                  && (
                    (request.resource.data.role == 'customer'
                      && request.resource.data.roles.hasOnly(['customer']))
                    || (isMasterAdmin()
                      && request.resource.data.role == 'admin'
                      && request.resource.data.roles.hasOnly(['admin']))
                  );
      allow update: if isAuthenticated() && (
        (request.auth.uid == uid && isAllowedUserWrite())
        || isAdmin()
        || (isMasterAdmin() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['isMasterAdmin']))
        || (isMasterAdmin() && request.auth.uid == uid
            && request.resource.data.role == 'admin'
            && request.resource.data.roles.hasAny(['admin'])
            && request.resource.data.roleStatus.admin == 'approved')
      );
      allow delete: if isAdmin();
    }

    // ============================================================
    // Role subcollections (users/{uid}/vendorProfile, riderProfile, etc.)
    // ============================================================
    match /users/{uid}/{roleProfile}/{document=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();
    }

    // ============================================================
    // stalls/{stallId}
    // ============================================================
    match /stalls/{stallId} {

      allow read: if true;

      allow create: if isAuthenticated()
                  && isRole('vendor')
                  && request.resource.data.vendorId == request.auth.uid
                  && request.resource.data.keys().hasAll(['id', 'name', 'vendorId'])
                  && request.resource.data.name is string
                  && request.resource.data.name.size() > 0;

      allow update: if isAuthenticated()
                  && (
                    (resource.data.vendorId == request.auth.uid && isRole('vendor'))
                    || isAdmin()
                  )
                  && request.resource.data.name is string
                  && request.resource.data.name.size() > 0;

      allow delete: if isAdmin();
    }

    // ============================================================
    // orders/{orderId}
    // ============================================================
    match /orders/{orderId} {

      allow read: if isAuthenticated()
                  && (
                    resource.data.userId == request.auth.uid
                    || resource.data.vendorId == request.auth.uid
                    || resource.data.riderId == request.auth.uid
                    || (roleStatusIs('rider', 'approved') && resource.data.status == 'ready')
                    || isAdmin()
                  );

      allow create: if isAuthenticated()
                  && request.resource.data.userId == request.auth.uid
                  && request.resource.data.keys().hasAll(['userId', 'items', 'total', 'status', 'stallId']);

      allow update: if isAuthenticated()
                  && (
                    (resource.data.vendorId == request.auth.uid && isRole('vendor'))
                    || (resource.data.riderId == request.auth.uid && isRole('rider'))
                    || (resource.data.status == 'ready' && resource.data.riderId == null
                        && roleStatusIs('rider', 'approved')
                        && request.resource.data.riderId == request.auth.uid
                        && request.resource.data.status == 'delivering')
                    || (resource.data.userId == request.auth.uid
                        && request.resource.data.status == 'cancelled'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledReason']))
                    || isAdmin()
                  );

      allow delete: if isAdmin();
    }

    // ============================================================
    // reviews/{reviewId}
    // ============================================================
    match /reviews/{reviewId} {

      // Public read so anyone (including guests browsing a stall) can view reviews.
      allow read: if true;

      allow create: if isAuthenticated()
                  && request.resource.data.userId == request.auth.uid
                  && request.resource.data.keys().hasAll(['userId', 'stallId', 'rating', 'comment']);

      allow update: if false;

      allow delete: if isAdmin();
    }

    // ============================================================
    // riderReviews/{reviewId}
    // ============================================================
    match /riderReviews/{reviewId} {

      allow read: if isAuthenticated()
                && (
                  request.auth.uid == resource.data.riderId
                  || isAdmin()
                );

      allow create: if isAuthenticated()
                  && request.resource.data.userId == request.auth.uid
                  && request.resource.data.keys().hasAll(['userId', 'riderId', 'rating', 'comment']);

      allow update: if false;

      allow delete: if isAdmin();
    }

    // ============================================================
    // applications/{docId}
    // ============================================================
    match /applications/{docId} {

      allow create: if isAuthenticated()
                  && request.resource.data.userId == request.auth.uid
                  && request.resource.data.keys().hasAll(['userId', 'role', 'status'])
                  && request.resource.data.role in ['vendor', 'rider']
                  && request.resource.data.status == 'pending';

      allow read: if isAuthenticated()
                && (
                  resource.data.userId == request.auth.uid
                  || isAdmin()
                );

      allow update: if isAdmin()
                  && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['status', 'reviewedAt', 'reviewedBy', 'rejectionReason']);

      allow delete: if false;
    }

    // ============================================================
    // riderLocation/{orderId}
    // ============================================================
    match /riderLocation/{orderId} {
      allow read: if isAuthenticated()
                  && (
                    resource.data.riderId == request.auth.uid
                    || get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid
                    || get(/databases/$(database)/documents/orders/$(orderId)).data.vendorId == request.auth.uid
                    || isAdmin()
                  );
      allow write: if isAuthenticated()
                  && request.resource.data.riderId == request.auth.uid
                  && request.resource.data.keys().hasAll(['lat', 'lng', 'riderId'])
                  && request.resource.data.lat is number
                  && request.resource.data.lng is number;
      allow delete: if isAdmin();
    }

    // ============================================================
    // otp_requests/{docId}
    // - COMPLETELY BLOCKED from client access
    // - Only Cloud Functions (Admin SDK) can read/write
    // - Protects hashed OTP and attempt tracking from client tampering
    // ============================================================
    match /otp_requests/{docId} {
      allow read, write: if false;
    }

    // ============================================================
    // suspicious_activity/{docId}
    // - Only Cloud Functions (Admin SDK) can write
    // - Admins can read for monitoring
    // ============================================================
    match /suspicious_activity/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================================
    // config/{configId}
    // ============================================================
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // notifications/{notificationId}
    // ============================================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated()
                  && (
                    resource.data.userId == request.auth.uid
                    || resource.data.vendorId == request.auth.uid
                    || resource.data.riderId == request.auth.uid
                    || isAdmin()
                  );
      allow create: if isAuthenticated()
                  && (
                    request.resource.data.userId == request.auth.uid
                    || request.resource.data.vendorId == request.auth.uid
                    || request.resource.data.riderId == request.auth.uid
                  );
      allow update: if isAuthenticated()
                  && (
                    resource.data.userId == request.auth.uid
                    || resource.data.vendorId == request.auth.uid
                    || resource.data.riderId == request.auth.uid
                    || isAdmin()
                  )
                  && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['read', 'isRead']);
      allow delete: if isAdmin();
    }

    // ============================================================
    // messages/{messageId}
    // ============================================================
    match /messages/{messageId} {
      allow read: if isAuthenticated()
                  && (
                    resource.data.senderId == request.auth.uid
                    || resource.data.recipientId == request.auth.uid
                    || resource.data.receiverId == request.auth.uid
                    || isAdmin()
                  );
      allow create: if isAuthenticated()
                  && request.resource.data.senderId == request.auth.uid
                  && request.resource.data.keys().hasAny(['content', 'senderId']);
      allow update: if isAuthenticated()
                  && (
                    resource.data.recipientId == request.auth.uid
                    || resource.data.receiverId == request.auth.uid
                    || isAdmin()
                  )
                  && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['read', 'isRead']);
      allow delete: if isAdmin();
    }

    // ============================================================
    // Deny all other collections and operations by default
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
